stardf-arrow:export-release a stardf-arrow:CabiExport ;
    rdfs:label "stardf_release" ;
    stardf-arrow:targetSymbol "stardf_release" ;
    stardf-arrow:subsystem "Batch" ;
    stardf-arrow:interopSurface "ArrowArrayStream" ;
    stardf-arrow:crate "capi" .

# --- ReleaseOutcome typed C ABI surface ---
#
# GROUNDED: crates/stardf-arrow-capi/src/lib.rs:349 — `#[repr(i32)] pub enum
# ReleaseOutcome { Released, ReleasedViaForeign }` (no explicit discriminants,
# so Released = 0, ReleasedViaForeign = 1 by Rust repr(i32) rules); it is the
# return type of stardf_release (lib.rs:410). NOTE: stardf-arrow-core's
# ReleaseOutcome (core/src/release.rs:29) adds DoubleRelease, but that enum is
# a core-internal type with no #[repr(i32)] C ABI surface — it is NOT part of
# the capi wire contract and is deliberately not modeled here.

stardf-arrow:ReleaseOutcome a rdfs:Class ;
    rdfs:label "ReleaseOutcome" ;
    rdfs:comment "Typed C ABI result of stardf_release. GROUNDED: capi/src/lib.rs:349 #[repr(i32)] enum { Released = 0, ReleasedViaForeign = 1 } (implicit discriminants)." .

stardf-arrow:release-outcome-released a stardf-arrow:ReleaseOutcome ;
    rdfs:label "Released" ;
    stardf-arrow:discriminant "0"^^xsd:int ;
    rdfs:comment "Freed through stardf's tagged release chain (lib.rs:438)." .

stardf-arrow:release-outcome-released-via-foreign a stardf-arrow:ReleaseOutcome ;
    rdfs:label "ReleasedViaForeign" ;
    stardf-arrow:discriminant "1"^^xsd:int ;
    rdfs:comment "Freed (leaked) through the untagged foreign path — mutant posture, or null-array input (lib.rs:416,423)." .

stardf-arrow:returnsOutcome a rdfs:Property ;
    rdfs:label "returnsOutcome" ;
    rdfs:comment "Links a CabiExport to its typed ReleaseOutcome C ABI result." .

stardf-arrow:export-release stardf-arrow:returnsOutcome stardf-arrow:ReleaseOutcome .

# --- Grounded interop-surface individual ---

stardf-arrow:arrow-array-stream a stardf-arrow:Stream ;
    rdfs:label "ArrowArrayStream" ;
    stardf-arrow:interopSurface "ArrowArrayStream" ;
    stardf-arrow:crate "capi+core" .
