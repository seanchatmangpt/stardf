# --- Execution Invariants SHACL Shape ---
stardf:ExecutionInvariantsShape
    a sh:NodeShape ;
    sh:targetClass stardf:KernelOperation ;
    sh:property [
        sh:path stardf:hasConditionalBranches ;
        sh:hasValue false ;
        sh:message "Kernel operations must compile to branchless bitwise/CMOV sequences." ;
    ] ;
    sh:property [
        sh:path stardf:dynamicAllocations ;
        sh:hasValue 0 ;
        sh:message "Heap allocation during state admission is strictly prohibited." ;
    ] .

# --- Memory Layouts ---
stardf:TermIdArenaDefinition
    a stardf:MemoryLayout ;
    stardf:byteAlignment 64 ;
    stardf:indexWidth "u32"^^xsd:string ;
    stardf:fingerprintHash "BLAKE3"^^xsd:string ;
    stardf:interopSurface "ArrowArrayStream" .

# --- ABI Function Validation Shape ---
stardf:AbiFunctionShape
    a sh:NodeShape ;
    sh:targetClass stardf:AbiFunction ;
    sh:property [
        sh:path stardf:targetSymbol ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path stardf:predecessorSymbol ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path stardf:returnType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path stardf:subsystem ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .

