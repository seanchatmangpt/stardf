# --- Root Mechanical Authority ---
stardf:SubstrateContract
    a stardf:MechanicalAuthority ;
    stardf:targetNamespace "stardf" ;
    stardf:predecessor "purrdf" ;
    stardf:executionModel stardf:BranchlessConstantTime ;
    stardf:memoryModel stardf:ZeroAllocationArena ;
    stardf:downstreamSubstrate "cgap" ;
    prov:wasDerivedFrom <file:///Users/sac/purrdf/crates/rdf-capi/include/purrdf.h> ;
